# OpenAI-compatible endpoint. Examples:
# OpenAI: https://api.openai.com/v1
# Ollama: http://127.0.0.1:11434/v1
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_TEXT_MODEL=qwen2.5:7b
AI_VISION_MODEL=qwen2.5vl:7b

# Build the browser app with the same-origin proxy enabled.
VITE_AI_API_URL=/api/ai

# Desktop update source. GitHub is the default package configuration.
COMPANION_UPDATE_PROVIDER=github
COMPANION_UPDATE_GITHUB_OWNER=Indigo6
COMPANION_UPDATE_GITHUB_REPO=companion-study-room
# Required when building with `npm run desktop:dist:generic`.
COMPANION_UPDATE_URL=https://updates.example.com/companion-study-room
